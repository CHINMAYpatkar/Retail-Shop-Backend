# Template only - copy to .env and fill in real values.
#
# Every value here is a PLACEHOLDER. This file used to hold live credentials,
# which is why it was gitignored - and that left new clones with no template at
# all, while a real app password sat in a file named "example". It was never
# committed (checked), but it was one `git add -f` away from being.
#
# The four JWT secrets must be four DIFFERENT random strings: the customer and
# admin audiences are deliberately separate, and sharing a secret between them
# turns a customer token into an admin one (ADR 0001).

# App
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/RetailShop?schema=public"

# JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Admin JWT (separate secrets so admin/customer tokens are never interchangeable)
ADMIN_JWT_ACCESS_SECRET=change-me-to-a-different-long-random-string
ADMIN_JWT_ACCESS_EXPIRES_IN=15m
ADMIN_JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
ADMIN_JWT_REFRESH_EXPIRES_IN=7d

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# SMTP (use a free provider initially e.g. Gmail app password, Mailtrap, Brevo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Retail Shop <you@gmail.com>"

# AWS S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
AWS_S3_BUCKET=retail-shop-media

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Storage (ADR 0008 - local disk now, S3 later behind the same driver interface)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:4000
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=200
MAX_DOCUMENT_SIZE_MB=10
# Set to 'false' ONLY for debugging - disabling this serves EXIF (incl. GPS) verbatim
PROCESS_IMAGES=true

# ---------------------------------------------------------------
# Verification runs use a SEPARATE database via .env.test (untracked).
# Create it once:
#   psql -c 'CREATE DATABASE "RetailShop_test"'
#   DATABASE_URL=...RetailShop_test npx prisma migrate deploy
# Then: bash scripts/test-api.sh
# Never point .env.test at RetailShop - mutating tests destroy stock and
# average-cost data, and there is no record of the previous values.
# ---------------------------------------------------------------
