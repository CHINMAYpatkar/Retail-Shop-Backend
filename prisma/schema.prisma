// Retail Shop (Home-made Spices) - Database Schema
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// ENUMS
// =========================================================

enum AdminRoleName {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED

  /// Partial refunds are the common case - one damaged jar out of four. Without
  /// this value a partial refund could only be recorded as a lie in one
  /// direction or the other.
  PARTIALLY_REFUNDED
  REFUNDED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BannerPlacement {
  HOME_HERO
  HOME_OFFER
  CATEGORY
  SLIDER
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

/// Which storage backend an asset actually lives on. Recorded per-asset so a
/// migration to S3 can proceed gradually - resolving each asset's URL through
/// its own driver - rather than needing a big-bang cutover. See ADR 0008.
enum StorageDriverName {
  LOCAL
  S3
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

/// Base unit a raw material is measured in. Deliberately ONE per material with
/// no conversion: buying a 5kg sack of a GRAM-based material is entered as
/// quantity 5000. That removes a whole class of rounding and conversion bugs.
enum MeasurementUnit {
  GRAM
  KILOGRAM
  MILLILITRE
  LITRE
  PIECE
  PACKET
}

/// Payment state of a purchase bill. DERIVED from linked payments at read
/// time, never stored - a stored status drifts the moment a payment is edited.
enum PurchaseBillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

/// One payment-method enum for the whole system: vendor payments, expenses and
/// customer refunds all use it, rather than three lists that drift apart.
enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  CARD
  OTHER
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARY
  PACKAGING
  TRANSPORT
  MARKETING
  EQUIPMENT
  MAINTENANCE
  MISC
}

/// Three states rather than a boolean, because "we agreed to refund" and "the
/// money has actually left the account" are often different days - and the gap
/// between them is a real liability worth seeing.
enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum OtpPurpose {
  REGISTER
  LOGIN
  RESET_PASSWORD
}

// =========================================================
// ADMIN / RBAC
// =========================================================

model AdminUser {
  id            String              @id @default(uuid())
  name          String
  email         String              @unique
  passwordHash  String
  isActive      Boolean             @default(true)
  lastLoginAt   DateTime?
  roleId        String
  role          Role                @relation(fields: [roleId], references: [id])
  refreshTokens AdminRefreshToken[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  activityLogs ActivityLog[]
  auditLogs    AuditLog[]

  @@map("admin_users")
}

model AdminRefreshToken {
  id          String    @id @default(uuid())
  tokenHash   String
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@map("admin_refresh_tokens")
}

model Role {
  id          String           @id @default(uuid())
  name        AdminRoleName
  description String?
  permissions RolePermission[]
  adminUsers  AdminUser[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([name])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique // e.g. "products.create"
  module      String // e.g. "products"
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// =========================================================
// CUSTOMERS / AUTH
// =========================================================

model Customer {
  id              String    @id @default(uuid())
  name            String?
  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String? // optional: OTP-first auth, password optional
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  addresses     Address[]
  wishlist      WishlistItem[]
  cart          CartItem[]
  orders        Order[]
  reviews       Review[]
  tickets       SupportTicket[]
  otps          OtpCode[]
  refreshTokens CustomerRefreshToken[]
  sessions      CustomerSession[]

  @@map("customers")
}

model CustomerRefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@map("customer_refresh_tokens")
}

model CustomerSession {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deviceId   String?
  userAgent  String?
  ipAddress  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@map("customer_sessions")
}

model OtpCode {
  id          String     @id @default(uuid())
  email       String
  codeHash    String
  purpose     OtpPurpose
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([email, purpose])
  @@map("otp_codes")
}

model Address {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String? // Home, Work, etc.
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[]

  @@map("addresses")
}

// =========================================================
// CATALOG: CATEGORIES / INGREDIENTS / PRODUCTS / RECIPES
// =========================================================

model Category {
  id              String     @id @default(uuid())
  name            String
  slug            String     @unique
  description     String?
  imageUrl        String?
  iconUrl         String?
  metaTitle       String?
  metaDescription String?
  isActive        Boolean    @default(true)
  sortOrder       Int        @default(0)
  parentId        String?
  parent          Category?  @relation("CategoryToParent", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryToParent")
  products        Product[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("categories")
}

model Ingredient {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  benefits    String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ProductIngredient[]
  recipes  RecipeIngredient[]

  /// Operational stock items mapping to this storefront ingredient. Optional on
  /// both sides - see ADR 0011 for why these are separate models.
  rawMaterials RawMaterial[]

  @@map("ingredients")
}

model Product {
  id                  String    @id @default(uuid())
  name                String
  slug                String    @unique
  shortDescription    String?
  description         String?
  price               Decimal   @db.Decimal(10, 2)
  compareAtPrice      Decimal?  @db.Decimal(10, 2)
  weightGrams         Int?
  shelfLifeDays       Int?
  storageInstructions String?
  preparationProcess  String?   @db.Text
  stockQuantity       Int       @default(0)
  sku                 String?   @unique
  isActive            Boolean   @default(true)
  isFeatured          Boolean   @default(false)
  deletedAt           DateTime? // soft delete
  metaTitle           String?
  metaDescription     String?

  // A deleted product may be retained for order history after its category is removed.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images       ProductImage[]
  variants     ProductVariant[]
  ingredients  ProductIngredient[]
  recipes      RecipeProduct[]
  reviews      Review[]
  wishlistedBy WishlistItem[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  costSheets   ProductCostSheet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int     @default(0)
  isVideo   Boolean @default(false)

  @@map("product_images")
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String // e.g. "250g", "500g"
  sku           String?  @unique
  priceOverride Decimal? @db.Decimal(10, 2)
  stockQuantity Int      @default(0)
  isActive      Boolean  @default(true)

  @@map("product_variants")
}

model ProductIngredient {
  productId    String
  ingredientId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
  @@map("product_ingredients")
}

model Recipe {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  description     String?
  steps           Json // ordered array of { title, description, imageUrl? }
  cookingTimeMins Int?
  difficulty      String? // Easy / Medium / Hard
  videoUrl        String?
  imageUrl        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ingredients RecipeIngredient[]
  products    RecipeProduct[]

  @@map("recipes")
}

model RecipeIngredient {
  recipeId     String
  ingredientId String
  quantity     String?
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

// Many-to-many: a recipe can use multiple spice products, a product can link to many recipes
model RecipeProduct {
  recipeId  String
  productId String
  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([recipeId, productId])
  @@map("recipe_products")
}

// =========================================================
// WISHLIST / CART
// =========================================================

model WishlistItem {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@map("wishlist_items")
}

model CartItem {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  variantId  String?
  quantity   Int      @default(1)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, productId, variantId])
  @@map("cart_items")
}

// =========================================================
// ORDERS
// =========================================================

model Order {
  id             String        @id @default(uuid())
  orderNumber    String        @unique
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  addressId      String
  address        Address       @relation(fields: [addressId], references: [id])
  status         OrderStatus   @default(PLACED)
  paymentMethod  PaymentMethod @default(COD)
  paymentStatus  PaymentStatus @default(PENDING)
  subtotal       Decimal       @db.Decimal(10, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(10, 2)
  shippingAmount Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal       @db.Decimal(10, 2)
  invoiceUrl     String?
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  refunds       Refund[]

  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  variantId   String?
  productName String // snapshot at time of order
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  totalPrice  Decimal @db.Decimal(10, 2)

  /// What this unit cost US, snapshotted from the product's active cost sheet
  /// at checkout - exactly as `unitPrice` snapshots what the customer paid.
  ///
  /// Stored rather than looked up so COGS is exact and permanently immutable:
  /// no as-of-date joins against versioned cost sheets at report time, and a
  /// later cost-sheet revision can never rewrite the margin on a past sale.
  /// Null for orders placed before cost sheets existed.
  unitCostPrice Decimal? @db.Decimal(12, 4)

  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  changedBy String? // admin user id or "system"
  createdAt DateTime    @default(now())

  @@map("order_status_history")
}

// =========================================================
// REVIEWS
// =========================================================

model Review {
  id                 String        @id @default(uuid())
  productId          String
  customerId         String
  product            Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer           Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating             Int
  title              String?
  comment            String?
  isVerifiedPurchase Boolean       @default(false)
  status             ReviewStatus  @default(PENDING)
  adminReply         String?
  images             ReviewImage[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("reviews")
}

model ReviewImage {
  id       String @id @default(uuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  /// Key of the customer-uploaded image, same contract as MediaAsset (ADR 0008).
  /// Nullable only for rows that predate uploads existing.
  storageKey String?

  /// Resolved at write time. Read through the service, which prefers storageKey.
  url String

  @@map("review_images")
}

// =========================================================
// CMS: BANNERS / PAGES / BLOGS / MEDIA
// =========================================================

model Banner {
  id       String  @id @default(uuid())
  title    String
  subtitle String?

  /// Still required: a banner must have an image, which doubles as the poster
  /// frame when a video is present and as the whole banner when it isn't.
  imageUrl String

  /// Optional promo/advertisement video. Rendered over imageUrl when set, so a
  /// storefront that can't play it still has something to show.
  videoUrl  String?
  ctaLabel  String?
  ctaUrl    String?
  placement BannerPlacement
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("banners")
}

model CmsPage {
  id              String   @id @default(uuid())
  slug            String   @unique // about, contact, privacy, terms, refund-policy
  title           String
  content         String   @db.Text
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("cms_pages")
}

model Blog {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  excerpt         String?
  content         String    @db.Text
  coverImageUrl   String?
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("blogs")
}

model FaqItem {
  id        String  @id @default(uuid())
  question  String
  answer    String  @db.Text
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  @@map("faq_items")
}

model MediaAsset {
  id         String    @id @default(uuid())
  fileName   String // original client-supplied name, for display only
  type       MediaType
  folder     String?
  sizeBytes  Int?
  uploadedBy String?
  createdAt  DateTime  @default(now())

  /// Driver-relative key, e.g. `products/2026/08/<uuid>.webp`.
  ///
  /// This - not `url` - is the durable identity of an uploaded file. Public
  /// URLs are resolved from it at read time, so changing storage backend never
  /// requires rewriting rows or breaking URLs already in the wild (ADR 0008).
  ///
  /// Null for assets added by external URL, which this project supports
  /// alongside uploads.
  storageKey String?            @unique
  driver     StorageDriverName?
  mimeType   String?

  /// Only meaningful for externally-linked assets. For uploaded assets the URL
  /// is derived from `storageKey`; do not read this column directly - go
  /// through MediaService, which resolves the right one.
  url String

  /// Scans of paper bills and payment receipts. SetNull so removing an asset
  /// never deletes the financial record that referenced it.
  purchaseBills  PurchaseBill[]
  vendorPayments VendorPayment[]
  expenses       Expense[]

  @@index([type, folder])
  @@index([createdAt])
  @@map("media_assets")
}

// =========================================================
// SUPPORT
// =========================================================

model SupportTicket {
  id           String          @id @default(uuid())
  ticketNumber String          @unique
  customerId   String?
  customer     Customer?       @relation(fields: [customerId], references: [id])
  name         String
  email        String
  subject      String
  status       TicketStatus    @default(OPEN)
  messages     TicketMessage[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("support_tickets")
}

model TicketMessage {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderType String // "customer" | "admin"
  senderName String?
  message    String        @db.Text
  createdAt  DateTime      @default(now())

  @@map("ticket_messages")
}

// =========================================================
// NOTIFICATIONS / SETTINGS / LOGS
// =========================================================

model Notification {
  id        String              @id @default(uuid())
  channel   NotificationChannel
  recipient String
  subject   String?
  body      String              @db.Text
  isSent    Boolean             @default(false)
  sentAt    DateTime?
  error     String?
  createdAt DateTime            @default(now())

  @@map("notifications")
}

// =========================================================
// PROCUREMENT (back office)
// =========================================================

/// A supplier of raw materials.
///
/// Outstanding balance is deliberately NOT stored - it is computed from bills
/// minus payments, because a stored balance drifts the first time anything is
/// edited or deleted.
model Vendor {
  id            String  @id @default(uuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  gstin         String? // tax registration id, informational only (ADR 0013)
  notes         String?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills    PurchaseBill[]
  payments VendorPayment[]
  expenses Expense[]

  @@index([isActive])
  @@map("vendors")
}

/// An operational inventory item - what is actually bought, stocked and consumed.
///
/// NOT the same thing as `Ingredient`, which is storefront content (name, story,
/// image). One ingredient can map to several raw materials (different grades or
/// pack sizes), and many raw materials have no ingredient at all: jars, labels,
/// pouches, cartons. Keeping them apart also keeps cost data off a model that
/// public routes read. See ADR 0011.
model RawMaterial {
  id       String          @id @default(uuid())
  name     String
  code     String?         @unique
  baseUnit MeasurementUnit

  /// Fractional quantities are normal (2.5 kg), hence Decimal rather than Int.
  stockQuantity Decimal  @default(0) @db.Decimal(12, 3)
  reorderLevel  Decimal? @db.Decimal(12, 3)

  /// Moving average, maintained when a purchase bill is recorded. 4dp because a
  /// per-gram cost is genuinely sub-paisa and rounding it compounds over a batch.
  avgCostPerUnit    Decimal? @db.Decimal(12, 4)
  lastPurchasePrice Decimal? @db.Decimal(12, 4)

  /// SetNull, not Cascade: removing the storefront ingredient must never delete
  /// the stock record or its cost history.
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseItems  PurchaseBillItem[]
  costSheetItems ProductCostSheetItem[]

  @@index([isActive])
  @@index([ingredientId])
  @@map("raw_materials")
}

/// A bill received from a vendor for raw materials.
///
/// Totals are computed SERVER-SIDE from the line items - the client sends only
/// tax and discount. Trusting a client-supplied total is how you end up with
/// bills whose figures do not add up to their own lines.
///
/// `paidAmount` and `status` are deliberately absent: both are derived from
/// linked payments at read time. A stored status drifts the moment a payment is
/// edited or deleted, and nothing would notice.
model PurchaseBill {
  id       String @id @default(uuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  /// The vendor's own bill number, from their paper bill.
  billNumber String
  billDate   DateTime
  dueDate    DateTime?

  subtotal       Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2) // stays 0, see ADR 0013
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)

  /// Scan or photo of the paper bill. Stored in the private uploads subtree, so
  /// it is only readable through the guarded documents route.
  attachmentMediaId String?
  attachment        MediaAsset? @relation(fields: [attachmentMediaId], references: [id], onDelete: SetNull)

  notes            String?
  createdByAdminId String?

  items    PurchaseBillItem[]
  payments VendorPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Stops the same paper bill being entered twice for one vendor.
  @@unique([vendorId, billNumber])
  @@index([billDate])
  @@index([vendorId])
  @@map("purchase_bills")
}

model PurchaseBillItem {
  id             String       @id @default(uuid())
  purchaseBillId String
  purchaseBill   PurchaseBill @relation(fields: [purchaseBillId], references: [id], onDelete: Cascade)

  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])

  /// Always in the material's own base unit - there is no conversion.
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 4)
  lineTotal Decimal @db.Decimal(12, 2)

  notes String?

  @@index([rawMaterialId])
  @@index([purchaseBillId])
  @@map("purchase_bill_items")
}

/// Money paid to a vendor. Either against one bill, or on account when
/// `purchaseBillId` is null (an advance).
///
/// Deliberately NO allocation table: a payment hits one bill or sits on
/// account. Full multi-bill allocation is real accounting machinery and overkill
/// here; adding the join table later would not disturb existing rows.
model VendorPayment {
  id       String @id @default(uuid())
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  purchaseBillId String?
  purchaseBill   PurchaseBill? @relation(fields: [purchaseBillId], references: [id], onDelete: SetNull)

  amount      Decimal     @db.Decimal(12, 2)
  paidOn      DateTime
  method      PaymentMode
  referenceNo String?

  attachmentMediaId String?
  attachment        MediaAsset? @relation(fields: [attachmentMediaId], references: [id], onDelete: SetNull)

  notes            String?
  createdByAdminId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([purchaseBillId])
  @@index([paidOn])
  @@map("vendor_payments")
}

/// What it costs to make a product: raw materials plus the making costs.
///
/// Versioned rather than edited in place. Changing a cost structure creates a
/// new version and deactivates the previous one, so a historical margin stays
/// answerable ("what did this cost us in August?") instead of being silently
/// rewritten by today's prices.
model ProductCostSheet {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  version       Int
  effectiveFrom DateTime @default(now())

  /// Exactly one active sheet per product. Creating a new version deactivates
  /// whatever was active before.
  isActive Boolean @default(true)

  /// How many sellable units one run of this sheet produces. Cost per unit is
  /// the batch total divided by this, so it must be at least 1.
  batchYieldQuantity Int

  /// Computed from the line items - never accepted from the client.
  materialCost Decimal @default(0) @db.Decimal(12, 2)

  /// The "making cost" side, entered by hand.
  labourCost    Decimal @default(0) @db.Decimal(12, 2)
  packagingCost Decimal @default(0) @db.Decimal(12, 2)
  overheadCost  Decimal @default(0) @db.Decimal(12, 2)
  otherCost     Decimal @default(0) @db.Decimal(12, 2)

  /// Both computed: total = materials + making costs, per-unit = total / yield.
  totalBatchCost Decimal @default(0) @db.Decimal(12, 2)
  costPerUnit    Decimal @default(0) @db.Decimal(12, 4)

  notes            String?
  createdByAdminId String?

  items ProductCostSheetItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, version])
  @@index([productId, isActive])
  @@map("product_cost_sheets")
}

model ProductCostSheetItem {
  id          String           @id @default(uuid())
  costSheetId String
  costSheet   ProductCostSheet @relation(fields: [costSheetId], references: [id], onDelete: Cascade)

  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])

  /// In the material's own base unit - no conversion, as everywhere else.
  quantity Decimal @db.Decimal(12, 3)

  /// SNAPSHOTTED, defaulted from the material's average cost when the sheet is
  /// created. Read live instead and every historical margin would shift each
  /// time a material price moved.
  ratePerUnit Decimal @db.Decimal(12, 4)
  lineCost    Decimal @db.Decimal(12, 2)

  notes String?

  @@index([costSheetId])
  @@index([rawMaterialId])
  @@map("product_cost_sheet_items")
}

/// Money spent running the business - everything that is not raw material.
///
/// Deliberately distinct from a refund: an expense is a cost of operating, a
/// refund reverses a sale. Filing refunds as expenses would leave net revenue
/// looking healthy while profit quietly was not, which is exactly the reporting
/// failure this domain exists to prevent.
model Expense {
  id       String          @id @default(uuid())
  category ExpenseCategory
  title    String
  amount   Decimal         @db.Decimal(12, 2)
  spentOn  DateTime
  method   PaymentMode

  /// Optional - only when the money went to a vendor we already track.
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  attachmentMediaId String?
  attachment        MediaAsset? @relation(fields: [attachmentMediaId], references: [id], onDelete: SetNull)

  notes String?

  /// Plain id rather than a relation on purpose: the audit trail must survive
  /// the admin account being deleted.
  createdByAdminId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spentOn])
  @@index([category])
  @@index([vendorId])
  @@map("expenses")
}

/// A refund the business has agreed to, or already paid, on an order.
///
/// A RECORD of what a human did, not a workflow: there is no payment gateway,
/// so refunds are sent by hand over UPI or bank transfer and this captures the
/// fact. See ADR 0012.
model Refund {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount Decimal      @db.Decimal(10, 2)
  reason String
  method PaymentMode
  status RefundStatus @default(PENDING)

  /// UPI transaction id, bank reference - the audit trail for money leaving.
  referenceNo String?

  /// Set when the status becomes COMPLETED, i.e. when the money actually went.
  refundedOn DateTime?

  notes String?

  /// Who processed it. Not optional in spirit - money movement must be
  /// attributable - and a plain id so it survives the admin being deleted.
  processedByAdminId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model ActivityLog {
  id          String     @id @default(uuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
  action      String
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime   @default(now())

  @@map("activity_logs")
}

model AuditLog {
  id          String     @id @default(uuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
  entityType  String
  entityId    String
  action      String // CREATE, UPDATE, DELETE
  before      Json?
  after       Json?
  createdAt   DateTime   @default(now())

  @@map("audit_logs")
}
