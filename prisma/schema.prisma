// Retail Shop (Home-made Spices) - Database Schema
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// ENUMS
// =========================================================

enum AdminRoleName {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BannerPlacement {
  HOME_HERO
  HOME_OFFER
  CATEGORY
  SLIDER
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

/// Which storage backend an asset actually lives on. Recorded per-asset so a
/// migration to S3 can proceed gradually - resolving each asset's URL through
/// its own driver - rather than needing a big-bang cutover. See ADR 0008.
enum StorageDriverName {
  LOCAL
  S3
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

/// Base unit a raw material is measured in. Deliberately ONE per material with
/// no conversion: buying a 5kg sack of a GRAM-based material is entered as
/// quantity 5000. That removes a whole class of rounding and conversion bugs.
enum MeasurementUnit {
  GRAM
  KILOGRAM
  MILLILITRE
  LITRE
  PIECE
  PACKET
}

enum OtpPurpose {
  REGISTER
  LOGIN
  RESET_PASSWORD
}

// =========================================================
// ADMIN / RBAC
// =========================================================

model AdminUser {
  id            String              @id @default(uuid())
  name          String
  email         String              @unique
  passwordHash  String
  isActive      Boolean             @default(true)
  lastLoginAt   DateTime?
  roleId        String
  role          Role                @relation(fields: [roleId], references: [id])
  refreshTokens AdminRefreshToken[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  activityLogs ActivityLog[]
  auditLogs    AuditLog[]

  @@map("admin_users")
}

model AdminRefreshToken {
  id          String    @id @default(uuid())
  tokenHash   String
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@map("admin_refresh_tokens")
}

model Role {
  id          String           @id @default(uuid())
  name        AdminRoleName
  description String?
  permissions RolePermission[]
  adminUsers  AdminUser[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([name])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique // e.g. "products.create"
  module      String // e.g. "products"
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// =========================================================
// CUSTOMERS / AUTH
// =========================================================

model Customer {
  id              String    @id @default(uuid())
  name            String?
  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String? // optional: OTP-first auth, password optional
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  addresses     Address[]
  wishlist      WishlistItem[]
  cart          CartItem[]
  orders        Order[]
  reviews       Review[]
  tickets       SupportTicket[]
  otps          OtpCode[]
  refreshTokens CustomerRefreshToken[]
  sessions      CustomerSession[]

  @@map("customers")
}

model CustomerRefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@map("customer_refresh_tokens")
}

model CustomerSession {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deviceId   String?
  userAgent  String?
  ipAddress  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@map("customer_sessions")
}

model OtpCode {
  id          String     @id @default(uuid())
  email       String
  codeHash    String
  purpose     OtpPurpose
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([email, purpose])
  @@map("otp_codes")
}

model Address {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String? // Home, Work, etc.
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[]

  @@map("addresses")
}

// =========================================================
// CATALOG: CATEGORIES / INGREDIENTS / PRODUCTS / RECIPES
// =========================================================

model Category {
  id              String     @id @default(uuid())
  name            String
  slug            String     @unique
  description     String?
  imageUrl        String?
  iconUrl         String?
  metaTitle       String?
  metaDescription String?
  isActive        Boolean    @default(true)
  sortOrder       Int        @default(0)
  parentId        String?
  parent          Category?  @relation("CategoryToParent", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryToParent")
  products        Product[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("categories")
}

model Ingredient {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  benefits    String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ProductIngredient[]
  recipes  RecipeIngredient[]

  /// Operational stock items mapping to this storefront ingredient. Optional on
  /// both sides - see ADR 0011 for why these are separate models.
  rawMaterials RawMaterial[]

  @@map("ingredients")
}

model Product {
  id                  String    @id @default(uuid())
  name                String
  slug                String    @unique
  shortDescription    String?
  description         String?
  price               Decimal   @db.Decimal(10, 2)
  compareAtPrice      Decimal?  @db.Decimal(10, 2)
  weightGrams         Int?
  shelfLifeDays       Int?
  storageInstructions String?
  preparationProcess  String?   @db.Text
  stockQuantity       Int       @default(0)
  sku                 String?   @unique
  isActive            Boolean   @default(true)
  isFeatured          Boolean   @default(false)
  deletedAt           DateTime? // soft delete
  metaTitle           String?
  metaDescription     String?

  // A deleted product may be retained for order history after its category is removed.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images       ProductImage[]
  variants     ProductVariant[]
  ingredients  ProductIngredient[]
  recipes      RecipeProduct[]
  reviews      Review[]
  wishlistedBy WishlistItem[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int     @default(0)
  isVideo   Boolean @default(false)

  @@map("product_images")
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String // e.g. "250g", "500g"
  sku           String?  @unique
  priceOverride Decimal? @db.Decimal(10, 2)
  stockQuantity Int      @default(0)
  isActive      Boolean  @default(true)

  @@map("product_variants")
}

model ProductIngredient {
  productId    String
  ingredientId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
  @@map("product_ingredients")
}

model Recipe {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  description     String?
  steps           Json // ordered array of { title, description, imageUrl? }
  cookingTimeMins Int?
  difficulty      String? // Easy / Medium / Hard
  videoUrl        String?
  imageUrl        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ingredients RecipeIngredient[]
  products    RecipeProduct[]

  @@map("recipes")
}

model RecipeIngredient {
  recipeId     String
  ingredientId String
  quantity     String?
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

// Many-to-many: a recipe can use multiple spice products, a product can link to many recipes
model RecipeProduct {
  recipeId  String
  productId String
  recipe    Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([recipeId, productId])
  @@map("recipe_products")
}

// =========================================================
// WISHLIST / CART
// =========================================================

model WishlistItem {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@map("wishlist_items")
}

model CartItem {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  variantId  String?
  quantity   Int      @default(1)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, productId, variantId])
  @@map("cart_items")
}

// =========================================================
// ORDERS
// =========================================================

model Order {
  id             String        @id @default(uuid())
  orderNumber    String        @unique
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  addressId      String
  address        Address       @relation(fields: [addressId], references: [id])
  status         OrderStatus   @default(PLACED)
  paymentMethod  PaymentMethod @default(COD)
  paymentStatus  PaymentStatus @default(PENDING)
  subtotal       Decimal       @db.Decimal(10, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(10, 2)
  shippingAmount Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal       @db.Decimal(10, 2)
  invoiceUrl     String?
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  variantId   String?
  productName String // snapshot at time of order
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  totalPrice  Decimal @db.Decimal(10, 2)

  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  changedBy String? // admin user id or "system"
  createdAt DateTime    @default(now())

  @@map("order_status_history")
}

// =========================================================
// REVIEWS
// =========================================================

model Review {
  id                 String        @id @default(uuid())
  productId          String
  customerId         String
  product            Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer           Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating             Int
  title              String?
  comment            String?
  isVerifiedPurchase Boolean       @default(false)
  status             ReviewStatus  @default(PENDING)
  adminReply         String?
  images             ReviewImage[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("reviews")
}

model ReviewImage {
  id       String @id @default(uuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  /// Key of the customer-uploaded image, same contract as MediaAsset (ADR 0008).
  /// Nullable only for rows that predate uploads existing.
  storageKey String?

  /// Resolved at write time. Read through the service, which prefers storageKey.
  url String

  @@map("review_images")
}

// =========================================================
// CMS: BANNERS / PAGES / BLOGS / MEDIA
// =========================================================

model Banner {
  id       String  @id @default(uuid())
  title    String
  subtitle String?

  /// Still required: a banner must have an image, which doubles as the poster
  /// frame when a video is present and as the whole banner when it isn't.
  imageUrl String

  /// Optional promo/advertisement video. Rendered over imageUrl when set, so a
  /// storefront that can't play it still has something to show.
  videoUrl  String?
  ctaLabel  String?
  ctaUrl    String?
  placement BannerPlacement
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("banners")
}

model CmsPage {
  id              String   @id @default(uuid())
  slug            String   @unique // about, contact, privacy, terms, refund-policy
  title           String
  content         String   @db.Text
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("cms_pages")
}

model Blog {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  excerpt         String?
  content         String    @db.Text
  coverImageUrl   String?
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("blogs")
}

model FaqItem {
  id        String  @id @default(uuid())
  question  String
  answer    String  @db.Text
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  @@map("faq_items")
}

model MediaAsset {
  id         String    @id @default(uuid())
  fileName   String // original client-supplied name, for display only
  type       MediaType
  folder     String?
  sizeBytes  Int?
  uploadedBy String?
  createdAt  DateTime  @default(now())

  /// Driver-relative key, e.g. `products/2026/08/<uuid>.webp`.
  ///
  /// This - not `url` - is the durable identity of an uploaded file. Public
  /// URLs are resolved from it at read time, so changing storage backend never
  /// requires rewriting rows or breaking URLs already in the wild (ADR 0008).
  ///
  /// Null for assets added by external URL, which this project supports
  /// alongside uploads.
  storageKey String?            @unique
  driver     StorageDriverName?
  mimeType   String?

  /// Only meaningful for externally-linked assets. For uploaded assets the URL
  /// is derived from `storageKey`; do not read this column directly - go
  /// through MediaService, which resolves the right one.
  url String

  @@index([type, folder])
  @@index([createdAt])
  @@map("media_assets")
}

// =========================================================
// SUPPORT
// =========================================================

model SupportTicket {
  id           String          @id @default(uuid())
  ticketNumber String          @unique
  customerId   String?
  customer     Customer?       @relation(fields: [customerId], references: [id])
  name         String
  email        String
  subject      String
  status       TicketStatus    @default(OPEN)
  messages     TicketMessage[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("support_tickets")
}

model TicketMessage {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderType String // "customer" | "admin"
  senderName String?
  message    String        @db.Text
  createdAt  DateTime      @default(now())

  @@map("ticket_messages")
}

// =========================================================
// NOTIFICATIONS / SETTINGS / LOGS
// =========================================================

model Notification {
  id        String              @id @default(uuid())
  channel   NotificationChannel
  recipient String
  subject   String?
  body      String              @db.Text
  isSent    Boolean             @default(false)
  sentAt    DateTime?
  error     String?
  createdAt DateTime            @default(now())

  @@map("notifications")
}

// =========================================================
// PROCUREMENT (back office)
// =========================================================

/// A supplier of raw materials.
///
/// Outstanding balance is deliberately NOT stored - it is computed from bills
/// minus payments, because a stored balance drifts the first time anything is
/// edited or deleted.
model Vendor {
  id            String  @id @default(uuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  gstin         String? // tax registration id, informational only (ADR 0013)
  notes         String?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("vendors")
}

/// An operational inventory item - what is actually bought, stocked and consumed.
///
/// NOT the same thing as `Ingredient`, which is storefront content (name, story,
/// image). One ingredient can map to several raw materials (different grades or
/// pack sizes), and many raw materials have no ingredient at all: jars, labels,
/// pouches, cartons. Keeping them apart also keeps cost data off a model that
/// public routes read. See ADR 0011.
model RawMaterial {
  id       String          @id @default(uuid())
  name     String
  code     String?         @unique
  baseUnit MeasurementUnit

  /// Fractional quantities are normal (2.5 kg), hence Decimal rather than Int.
  stockQuantity Decimal  @default(0) @db.Decimal(12, 3)
  reorderLevel  Decimal? @db.Decimal(12, 3)

  /// Moving average, maintained when a purchase bill is recorded. 4dp because a
  /// per-gram cost is genuinely sub-paisa and rounding it compounds over a batch.
  avgCostPerUnit    Decimal? @db.Decimal(12, 4)
  lastPurchasePrice Decimal? @db.Decimal(12, 4)

  /// SetNull, not Cascade: removing the storefront ingredient must never delete
  /// the stock record or its cost history.
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([ingredientId])
  @@map("raw_materials")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model ActivityLog {
  id          String     @id @default(uuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
  action      String
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime   @default(now())

  @@map("activity_logs")
}

model AuditLog {
  id          String     @id @default(uuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
  entityType  String
  entityId    String
  action      String // CREATE, UPDATE, DELETE
  before      Json?
  after       Json?
  createdAt   DateTime   @default(now())

  @@map("audit_logs")
}
