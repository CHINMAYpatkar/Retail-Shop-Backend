# App
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://postgres:root@localhost:5432/RetailShop?schema=public"

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Admin JWT (separate secrets so admin/customer tokens are never interchangeable)
ADMIN_JWT_ACCESS_SECRET=change_me_admin_access_secret
ADMIN_JWT_ACCESS_EXPIRES_IN=15m
ADMIN_JWT_REFRESH_SECRET=change_me_admin_refresh_secret
ADMIN_JWT_REFRESH_EXPIRES_IN=7d

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# SMTP (use a free provider initially e.g. Gmail app password, Mailtrap, Brevo)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=change_me
SMTP_FROM="Retail Shop <no-reply@retailshop.com>"

# AWS S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
AWS_S3_BUCKET=retail-shop-media

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
